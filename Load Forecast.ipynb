    "from util_func.classifiers.load_forecast import *\n",
    "\n",
    "%matplotlib inline\n",
    "plt.rcParams[\"figure.figsize\"]=(10,4)\n",
    "plt.rcParams['axes.grid'] = True \n",
    "\n",
